# ===========================================
# Alpha-Drivers Environment Configuration
# ===========================================

# ==========================================
# 🚀 QUICK START (Demo Mode - No database needed!)
# ==========================================
# Just copy this file to .env.local and run `npm run dev`
# The app will use mock data automatically.

# App URL (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Alpha-Drivers"

# Demo Mode
# Set to "true" to run without database (uses mock data)
# Set to "false" for production (requires DATABASE_URL)
NEXT_PUBLIC_DEMO_MODE=true

# Platform Settings
PLATFORM_COMMISSION_PERCENT=15
DRIVER_REGISTRATION_FEE=10000

# ==========================================
# 🔧 PRODUCTION CONFIG (Optional in demo mode)
# ==========================================
# Uncomment and configure these when ready for production

# Database (Supabase PostgreSQL)
# Get free database at: https://supabase.com
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase (for file storage - driver documents)
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth (for production authentication)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-a-random-32-char-string-here

# Notch Pay (Mobile Money - MTN MoMo & Orange Money)
# Get keys at: https://notchpay.co
# NOTCHPAY_PUBLIC_KEY=pk_test_...
# NOTCHPAY_SECRET_KEY=sk_test_...
# NOTCHPAY_WEBHOOK_SECRET=whsec_...

# SMS Provider (for OTP verification)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+237XXXXXXXXX

# Email (for notifications)
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@alpha-drivers.cm

# Feature Flags
NEXT_PUBLIC_ENABLE_VEHICLE_RENTAL=true
NEXT_PUBLIC_ENABLE_CHAT=true
